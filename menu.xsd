<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

<!--GERER LES CONTRAINTES AVEC <RESTRINCTION>-->

<xs:simpleType name="PrixType">
    <xs:restriction base="xs:decimal">
    <xs:minExclusive value="0"/>
    <xs:totalDigits value="4"/>
    <xs:fractionDigits value="2"/>
    </xs:restriction>
</xs:simpleType>


<xs:simpleType name="CaloriesType">
    <xs:restriction base="xs:integer">
    <xs:minInclusive value="100"/>
    <xs:maxInclusive value="2000"/>
    </xs:restriction>
</xs:simpleType>


<xs:simpleType name="CategorieType">
    <xs:restriction base="xs:string">
    <xs:enumeration value="sweet"/>
    <xs:enumeration value="salty"/>
    </xs:restriction>
</xs:simpleType>

<!-- RACINE DU DOCUMENT-->
<xs:element name="breakfast_menu">
    <xs:complexType>
    <xs:sequence>

    
        <xs:element name="food" maxOccurs="unbounded">
        <xs:complexType>
            <xs:sequence>

        
            <xs:element name="price">
                <xs:complexType>
                <xs:simpleContent>
                    <xs:extension base="PrixType">
                    <xs:attribute name="unit" type="xs:string" use="required"/>
                    </xs:extension>
                </xs:simpleContent>
                </xs:complexType>
            </xs:element>
            <xs:element name="calories" type="CaloriesType"/>
            </xs:sequence>

        
            <xs:attribute name="category" type="CategorieType" use="required"/>
        </xs:complexType>
        </xs:element>

    </xs:sequence>
    </xs:complexType>
</xs:element>

</xs:schema>
